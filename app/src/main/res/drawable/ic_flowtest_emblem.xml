<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Group with diagonal black & primary CyberCyan token and 3D security shield -->
    <group
        android:pivotX="54"
        android:pivotY="54">

        <!-- Outer ambient glow -->
        <path
            android:pathData="M54,54m-45,0a45,45 0,1 1,90 0a45,45 0,1 1,-90 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="54"
                    android:endX="99"
                    android:endY="99"
                    android:gradientRadius="45"
                    android:type="radial">
                    <item android:color="#4406B6D4" android:offset="0.0" />
                    <item android:color="#0006B6D4" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Circular Token: Cliped group for diagonal split (Black top-right, CyberCyan bottom-left) -->
        <group>
            <clip-path android:pathData="M54,54m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0" />

            <!-- Top-Right half & base: Deep Obsidian Black -->
            <path
                android:pathData="M0,0h108v108h-108z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="54"
                        android:startY="12"
                        android:endX="96"
                        android:endY="54"
                        android:type="linear">
                        <item android:color="#FF0F172A" android:offset="0.0" />
                        <item android:color="#FF070E17" android:offset="0.5" />
                        <item android:color="#FF050A10" android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Bottom-Left diagonal half: Primary CyberCyan gradient -->
            <path
                android:pathData="M0,0 L108,108 L0,108 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="12"
                        android:startY="54"
                        android:endX="54"
                        android:endY="96"
                        android:type="linear">
                        <item android:color="#FF06B6D4" android:offset="0.0" />
                        <item android:color="#FF0891B2" android:offset="0.55" />
                        <item android:color="#FF045366" android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Diagonal Dividing Seam Highlight -->
            <path
                android:pathData="M15,15 L93,93"
                android:strokeColor="#70FFFFFF"
                android:strokeWidth="1.2" />
        </group>

        <!-- Circular token outer rim stroke with specular highlight -->
        <path
            android:pathData="M54,54m-41.5,0a41.5,41.5 0,1 1,83 0a41.5,41.5 0,1 1,-83 0"
            android:strokeWidth="1.5">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="24"
                    android:startY="24"
                    android:endX="84"
                    android:endY="84"
                    android:type="linear">
                    <item android:color="#80FFFFFF" android:offset="0.0" />
                    <item android:color="#3006B6D4" android:offset="0.45" />
                    <item android:color="#00000000" android:offset="0.75" />
                    <item android:color="#400891B2" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Outer Shield Path (Embossed boundary) -->
        <path
            android:pathData="M54,32 C59,34 67,34.5 72,36 L72,55 C72,68 62,77 54,80 C46,77 36,68 36,55 L36,36 C41,34.5 49,34 54,32 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="40"
                    android:startY="32"
                    android:endX="68"
                    android:endY="80"
                    android:type="linear">
                    <item android:color="#FF02323E" android:offset="0.0" />
                    <item android:color="#FF045366" android:offset="0.5" />
                    <item android:color="#FF077A97" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner Shield Inset (Raised sculpted center face) -->
        <path
            android:pathData="M54,36 C58,37.5 64.5,38 68.5,39.2 L68.5,54.5 C68.5,65 60.5,73 54,75.5 C47.5,73 39.5,65 39.5,54.5 L39.5,39.2 C43.5,38 50,37.5 54,36 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="42"
                    android:startY="35"
                    android:endX="66"
                    android:endY="76"
                    android:type="linear">
                    <item android:color="#FF06B6D4" android:offset="0.0" />
                    <item android:color="#FF0891B2" android:offset="0.45" />
                    <item android:color="#FF045366" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Shield bevel ridge stroke -->
        <path
            android:pathData="M54,36 C58,37.5 64.5,38 68.5,39.2 L68.5,54.5 C68.5,65 60.5,73 54,75.5 C47.5,73 39.5,65 39.5,54.5 L39.5,39.2 C43.5,38 50,37.5 54,36 Z"
            android:strokeColor="#70E0F7FA"
            android:strokeWidth="0.8" />
    </group>
</vector>
