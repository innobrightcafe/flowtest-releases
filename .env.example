# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="default_gemini_key"

# CLOUDRUN SECURE SECRETS & BACKEND PROXY GATEWAY
# All sensitive 3rd-party APIs (Pairgate, Moniepoint, SMTP OTP, HttpSMS) are securely proxied via Cloud Run.
CLOUDRUN_BACKEND_URL="https://api.flowtest2026.com"
BACKEND_URL="https://api.flowtest2026.com"

# MONIEPOINT MFB WEBHOOK & INSTANT DEPOSIT CONFIGURATION
# MONIEPOINT_WEBHOOK_URL: Public HTTPS webhook endpoint registered in Moniepoint Developer Dashboard
MONIEPOINT_WEBHOOK_URL="https://api.flowtest2026.com/api/webhook/moniepoint"
# MONIEPOINT_WEBHOOK_SECRET: Secret key used to compute and verify HMAC-SHA256 signatures in the 'moniepoint-signature' header
MONIEPOINT_WEBHOOK_SECRET="mnp_whsec_placeholder"

# PAIRGATE_API_KEY: Secret API Token from your Pairgate Developer/Reseller Dashboard (stored on Cloud Run backend)
PAIRGATE_API_KEY="PG_live_KWSnkTrR4rs4nkZs3jxU9xjLvLcefpLD89cV6SbA4gHzU"
# PAIRGATE_WEBHOOK_URL: The endpoint URL configured in Pairgate dashboard for webhook callbacks
PAIRGATE_WEBHOOK_URL="https://api.flowtest2026.com/api/v1/pairgate/webhook"
# PAIRGATE_WEBHOOK_SECRET: Secret hash token used to verify HMAC-SHA512 webhook signatures
PAIRGATE_WEBHOOK_SECRET="pg_whsec_placeholder"

