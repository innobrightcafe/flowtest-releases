# ==============================================================================
# 📦 PUBLIC GITHUB RELEASES (Free Global CDN for Private Repositories)
# ==============================================================================
# PUBLIC_REPO_NAME: Public repository where built APKs and releases are published
# e.g., innobrightcafe/flowtest-releases
PUBLIC_REPO_NAME="innobrightcafe/flowtest-releases"
# RELEASE_REPO_TOKEN: GitHub Personal Access Token (classic with repo scope) allowing
# your private repository's GitHub Actions workflow to upload releases to the public repo
RELEASE_REPO_TOKEN="default_release_token"

# ==============================================================================
# ☁️ CLOUDFLARE R2 OBJECT STORAGE (Zero-Egress APK Mirror & Distribution)
# ==============================================================================
# R2_PUBLIC_URL: Public CDN URL to FlowTest.apk (e.g. custom domain or r2.dev)
# e.g., https://pub-xxxxxxxxxxxxxxxx.r2.dev/FlowTest.apk or https://apk.flowtest2026.com/FlowTest.apk
R2_PUBLIC_URL="default_r2_url"
# R2_ACCOUNT_ID: Cloudflare Account ID (found in Cloudflare dashboard URL or R2 overview)
R2_ACCOUNT_ID="default_r2_account"
# R2_ACCESS_KEY_ID: S3 API Access Key ID generated under R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID="default_r2_access_key"
# R2_SECRET_ACCESS_KEY: S3 API Secret Access Key generated under R2 -> Manage R2 API Tokens
R2_SECRET_ACCESS_KEY="default_r2_secret_key"
# R2_BUCKET_NAME: Name of the R2 bucket (e.g., flowtest-apk)
R2_BUCKET_NAME="flowtest-apk"



